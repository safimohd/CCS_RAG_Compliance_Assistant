# Copy this file to .env and fill in the values.
#
#     copy .env.example .env
#
# .env is gitignored - NEVER commit it, and never paste a key into a chat.

# ── OpenAI: the main model (gpt-5-nano), used by the chatbot and the RAG condition
OPENAI_API_KEY=sk-your-key-here

# ── OpenRouter: the two comparison base models for the evaluation run
#      - openai/gpt-oss-20b          (paid endpoints only; ~6 cents for the
#                                     whole 400-generation run)
#      - google/gemma-4-26b-a4b-it   (one free endpoint, via Google AI Studio)
#
# Replaces Together, whose key returns a persistent 401 and cannot be
# regenerated here. Needed only by the evaluation runner; the chatbot itself
# runs on OpenAI alone.
#
# Free-variant model ids (ending ':free') are capped per UTC day: 50 requests
# if under 10 credits have ever been purchased on the account, 1000 at or
# above. 100 questions per condition per domain therefore STALLS at 50 on a
# fresh account and resumes after 00:00 UTC. `run_evaluation.py --preflight`
# reads the remaining quota and warns before the run starts.
OPENROUTER_API_KEY=

# Model used for answer generation in the chatbot.
LLM_MODEL=gpt-5-nano

# Only set this if you are routing the chatbot through an OpenAI-compatible
# gateway. Leave unset for OpenAI itself. The evaluation runner sets its own
# per-model base URLs and ignores this.
# LLM_BASE_URL=https://openrouter.ai/api/v1
