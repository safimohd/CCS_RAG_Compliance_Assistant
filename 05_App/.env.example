# Copy this file to .env and fill in the values.
#
#     copy .env.example .env
#
# .env is gitignored - NEVER commit it, and never paste a key into a chat.

# ── OpenAI: the main model (gpt-5-nano), used by the chatbot and the RAG condition
OPENAI_API_KEY=sk-your-key-here

# ── Together: the two comparison base models for the evaluation run
#      - gpt-oss-20b
#      - Google Gemma 3N E4B Instruct
# Needed only by the evaluation runner. The chatbot itself runs on OpenAI alone.
TOGETHER_API_KEY=

# Model used for answer generation in the chatbot.
LLM_MODEL=gpt-5-nano

# Only set this if you are routing the chatbot through an OpenAI-compatible
# gateway. Leave unset for OpenAI itself. The evaluation runner sets its own
# per-model base URLs and ignores this.
# LLM_BASE_URL=https://api.together.xyz/v1
